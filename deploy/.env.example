# Copy to .env next to docker-compose.yml. Never commit .env.

# Public hostname (DNS A record -> this VM). A free DuckDNS name works.
DOMAIN=borga.example.com

# Database (the app connects as the borga user)
MYSQL_ROOT_PASSWORD=change-me-long-random
MYSQL_PASSWORD=change-me-long-random-too

# Generate each with: openssl rand -hex 32
SESSION_SECRET=
BORGA_SECRET_KEY=
CRON_SECRET=

# Outbound email (ticket replies, password resets). Oracle blocks port 25: use 587 or 465 via a provider.
# MailDog (https://maildog.io) is the simplest option: create an account, then set these three and leave SMTP_* empty.
# MAILDOG_USER=you@yourdomain.com
# MAILDOG_PASSWORD=your-maildog-password
# MAILDOG_FROM=Borga <noreply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Borga <noreply@example.com>

# Administrators (comma-separated emails). Only these can change the shared API keys and issue signup invites,
# and they can always sign up. The server will not start without this.
BORGA_OPERATOR_EMAILS=

# Who may create an account: invite (default; an administrator issues single-use codes), closed, or open.
SIGNUP_MODE=invite

# Optional
BORGA_ADMIN_TOKEN=
# Force features off for everyone, e.g. BORGA_FEATURES_OFF=calls,social
BORGA_FEATURES_OFF=

# Public https address used for links in emails (usually https://$DOMAIN)
APP_URL=

# ── Billing: $2 per user per month, paid before a workspace is set up ───────────────────────────────────────────
# Off by default. "enforce" turns it on: new workspaces are locked until paid, and companies that already exist get
# BILLING_GRACE_DAYS to subscribe. Do not enable it before Stripe is set up: the server refuses to start without the keys.
BILLING_MODE=off
# Stripe secret key (sk_live_... or sk_test_...) and the signing secret of the webhook endpoint (whsec_...).
# Webhook: https://YOUR-DOMAIN/api/borga/billing/webhook, events checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The day billing begins (YYYY-MM-DD). Companies created before it are "existing" and get the grace period below.
BILLING_STARTS_ON=
BILLING_GRACE_DAYS=14

# ── Bank feeds (Salt Edge). Optional: each company can instead enter its own under Connections. ─────────────────
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
# Live clients sign requests: PEM private key with \n for line breaks (upload the public key in the Salt Edge dashboard).
SALTEDGE_PRIVATE_KEY=
