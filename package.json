{
  "name": "vibe-web-template",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "pnpm": "10.33.4"
  },
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "pnpm build && electron-builder",
    "dev": "next dev -p 13000",
    "build": "pnpm check:server-boundaries && next build",
    "start": "next start -p 13000",
    "test": "node --import tsx --test lib/request.test.ts lib/tickets.test.ts lib/features.test.ts lib/phase0.test.ts lib/recurring.test.ts lib/supermemory.test.ts lib/services.test.ts lib/crm.test.ts lib/email.test.ts lib/boot.test.ts lib/ssrf.test.ts lib/signup.test.ts lib/models.test.ts lib/proxy.test.ts scripts/check-server-boundaries.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:server-boundaries": "node scripts/check-server-boundaries.mjs",
    "db:clear": "node --import tsx scripts/clear-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^2.1.2",
    "lucide-react": "^0.564.0",
    "mailparser": "^3.9.32",
    "mysql2": "^3.24.2",
    "next": "^16.2.12",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "agentation": "^2.0.0",
    "drizzle-kit": "^0.31.9",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.comprun.borga",
    "productName": "Borga",
    "copyright": "Copyright © 2026 Borga",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      ".next/**",
      "!.next/cache/**",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
