# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/borga-product.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/serve*.log

# env files (can opt-in for committing if needed)
!.env.example
.env

# vercel
.vercel

# electron / desktop build output (multi-GB installers — never commit)
/dist-electron/
/dist-desktop/
/electron-build.log

# cloudflare / opennext build artifacts
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode/*
.idea/*

# Remote Control runtime data
/remote-control/data/
!/remote-control/data/.gitkeep


# Local database dumps (contain user data): never commit
/backups/
deploy/backups/
