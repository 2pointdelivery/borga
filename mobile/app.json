{
  "expo": {
    "name": "Borga",
    "slug": "borga-mobile",
    "owner": "ansah-group",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "borga",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.comprun.borga",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Borga needs camera access for attachments and profile photos.",
        "NSMicrophoneUsageDescription": "Borga needs microphone access for voice notes and calls.",
        "NSPhotoLibraryUsageDescription": "Borga needs photo access for attachments."
      }
    },
    "android": {
      "package": "com.comprun.borga",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrlDefault": "http://10.0.0.170:13000",
      "eas": {
        "projectId": "c228f8cf-3232-4890-8839-a21270d8015e"
      }
    }
  }
}
