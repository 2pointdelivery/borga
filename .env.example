DATABASE_URL=mysql://root:@localhost:3306/borga   # MySQL 8 / MariaDB / TiDB (mysql2 driver — NOT Postgres)
LOG_DIR=./vibe-web-template

LLM_BASE_URL=example
LLM_API_KEY=xxx

# --- LLM provider API keys (server-side only; at least one required for Borga chat) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Company Engine (your CRM / company API) ---
# Each company normally saves its own URL + key under AI Platform -> Company Engine.
# These are optional deployment-wide fallbacks.
# COMPANY_ENGINE_API_KEY=
# Base URL for the company orchestration API (no trailing slash).
BORGA_ENGINE_URL=

# Reactus API base address (scheme + host only, no trailing slash)
REACTUS_BASE_URL=https://dev-reactus-api.happyseeds.ai

# Happy Seeds watermark validation + PROJECT_ID
HAPPYSEEDS_PROJECT_ID=

# Umami Analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-umami-domain/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-website-id"

# --- Borga always-on heartbeat (server-only, never paste into the dashboard) ---
# Bearer secret for POST /api/borga/cron — point any 5-minute scheduler at it
# so checks fire while the laptop sleeps. Leave empty to disable the endpoint.
CRON_SECRET=

# --- Feature kill switch (comma list; see lib/borga/features.ts) ---
# Forces features off for the whole deployment, e.g. BORGA_FEATURES_OFF=voice,calls
BORGA_FEATURES_OFF=

# --- Secrets ---
# SESSION_SECRET / BORGA_SECRET_KEY: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Supermemory (optional long-term AI memory; also needs Settings -> Features -> Supermemory) ---
# Deployment-wide key; a company can instead save its own under Integrations -> Connections.
SUPERMEMORY_API_KEY=

# Allow the Company Engine to call a CRM on a private network (default: public https only in production).
# BORGA_ALLOW_PRIVATE_ENGINE=1

# --- Email updates ---
# Public address of this Borga instance, used for links inside emails sent by cron. Optional: it is also
# remembered automatically from the browser when someone saves Settings -> Email updates.
# APP_URL=https://borga.example.com
